      "parameters": {
        "jsCode": "// Parse screen size and initialize workflow state\nconst raw = $input.first().json.output || '';\nconst m = raw.match(/(\\d+)\\s*x\\s*(\\d+)/i);\n\nlet width = 1080, height = 2408;\nif (m) {\n  width = parseInt(m[1], 10);\n  height = parseInt(m[2], 10);\n}\n\n// PRECISE COORDINATES based on actual screenshots (1080x2408)\nconst coordinates = {\n  // Bottom navigation bar (y ≈ 2336px)\n  HOME_TAB: { x: 0.092, y: 0.970 },           // Home icon: ~100px\n  SEARCH_TAB: { x: 0.273, y: 0.970 },         // Search icon: ~295px\n  CREATE_TAB: { x: 0.455, y: 0.970 },         // + Create: ~491px\n  REELS_TAB: { x: 0.636, y: 0.970 },          // Reels (Play): ~687px\n  PROFILE_TAB: { x: 0.818, y: 0.970 },        // Profile: ~883px\n  \n  // Top buttons\n  CREATE_BUTTON: { x: 0.089, y: 0.145 },      // + button top-left: ~96px, 349px\n  CLOSE_BUTTON: { x: 0.089, y: 0.145 },       // X close button: ~96px, 349px\n  BACK_BUTTON: { x: 0.089, y: 0.145 },        // Back arrow: ~96px, 349px\n  SETTINGS_BUTTON: { x: 0.944, y: 0.145 },    // Settings/gear: ~1020px, 349px\n  \n  // Gallery/Create screen (Image 4)\n  CAMERA_BUTTON: { x: 0.130, y: 0.375 },      // Camera button left side: ~140px, 903px\n  FIRST_VIDEO: { x: 0.730, y: 0.390 },        // First thumbnail top-right: ~788px, 939px\n  REEL_BUTTON: { x: 0.615, y: 0.970 },        // REEL button bottom: ~664px, 2336px\n  POST_BUTTON: { x: 0.498, y: 0.970 },        // POST button: ~538px, 2336px\n  STORY_BUTTON: { x: 0.557, y: 0.970 },       // STORY button: ~601px, 2336px\n  \n  // Edit screen (Image 1)\n  NEXT_BUTTON: { x: 0.740, y: 0.970 },        // Next button: ~799px, 2336px\n  EDIT_VIDEO_BTN: { x: 0.490, y: 0.970 },     // Edit video: ~529px, 2336px\n  \n  // Caption/Share screen (Image 2)\n  SHARE_BUTTON: { x: 0.702, y: 0.970 },       // Share button: ~758px, 2336px\n  SAVE_DRAFT: { x: 0.534, y: 0.970 },         // Save draft: ~577px, 2336px\n  CAPTION_FIELD: { x: 0.500, y: 0.462 },      // Caption input: ~540px, 1112px\n  TAG_PEOPLE: { x: 0.500, y: 0.570 },         // Tag people: ~540px, 1373px\n  ADD_LOCATION: { x: 0.500, y: 0.613 },       // Add location: ~540px, 1476px\n  \n  // Common\n  DISMISS_POPUP: { x: 0.500, y: 0.800 },      // Generic popup center\n  SCREEN_CENTER: { x: 0.500, y: 0.500 }       // Dead center\n};\n\nreturn {\n  width,\n  height,\n  coordinates,\n  retryCount: 0,\n  maxRetries: 50,\n  currentStep: 'INITIAL'\n};"
